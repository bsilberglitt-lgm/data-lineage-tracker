# Copy to .env and adjust if you run the app outside Docker Compose.
# Docker Compose sets these for you, so you do NOT need a .env file for it.
#
# Never commit a real .env — it is excluded in .gitignore.

# PostgreSQL connection string (required).
#   Docker Compose (from your Mac):  postgresql://lineage:lineage@localhost:5432/lineage
#   Render: copy the Internal Database URL from your Postgres instance
DATABASE_URL=postgresql://lineage:lineage@localhost:5432/lineage

# Port the web server listens on (optional, default 8765).
PORT=8765

# --- First run only: the initial SuperAdmin account -------------------------
# Used once, when the user table is empty. If the password is omitted, a strong
# one is generated and printed to the logs a single time. The account must
# change its password at first sign-in either way.
BOOTSTRAP_SUPERADMIN_EMAIL=you@example.gov
BOOTSTRAP_SUPERADMIN_PASSWORD=
BOOTSTRAP_SUPERADMIN_FIRST_NAME=Your
BOOTSTRAP_SUPERADMIN_LAST_NAME=Name

# --- Email ------------------------------------------------------------------
# Only the CREDENTIAL lives here. Everything else about email — which
# transport, the host, the port, the from address, the public address of this
# app — is set by a SuperAdmin in Preferences, so configuring mail does not
# require access to the infrastructure the app runs on.
#
# The credential is deliberately NOT in the database: it would travel in every
# nightly backup, and encrypting it there needs a key that would have to be an
# environment variable anyway, so it would move the secret rather than protect
# it. Set whichever one matches the transport chosen in Preferences, then
# restart the app — this is read at send time, but the app has to be running
# with it in its environment.

# For Preferences -> Email delivery = SMTP
# SMTP_PASSWORD=

# For Preferences -> Email delivery = Resend
# RESEND_API_KEY=

# --- Testing only -----------------------------------------------------------
# When set, NO EMAIL IS SENT: every message is appended to this file as one
# JSON object per line and the app reports success. It exists so the test
# suite can read what "was sent" and can never mail a real person.
#
# **Never set this on a real deployment.** Password reset would report success
# and deliver nothing. The app prints a loud warning at every startup when it
# finds it, and Preferences -> Email status says so too.
# EMAIL_SINK_PATH=/tmp/mail.jsonl

# --- Optional tuning --------------------------------------------------------
# scrypt cost for password hashing. Higher is stronger but slower and uses more
# memory (2^15 needs about 32 MiB per hash). Existing hashes keep working.
# SCRYPT_N=32768
