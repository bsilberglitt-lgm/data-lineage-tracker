# Secrets / local configuration
.env

# Legacy SQLite database (the app now uses PostgreSQL). Kept on disk as a
# historical backup and as the source for migrate_sqlite_to_postgres.py, but
# deliberately untracked — otherwise `git add -A` would re-add it.
lineage.db
lineage.db-journal
lineage.db-wal
lineage.db-shm
*.bak

# Generated exports
*.xlsx

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS / Office temp files
.DS_Store
~$*
