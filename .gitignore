# Secrets / local configuration
.env

# The legacy SQLite database. It was Maine DOE's pre-auth data and the seed
# for the test harness, and was removed from the repository in 0.9.1 before
# the project was shared: it held one department's real schema, 118 tables and
# 3,304 column names. The harness now builds from the migrations alone.
#
# Still listed so that a copy sitting in a working directory cannot be re-added
# by `git add -A`.
lineage.db
lineage.db-journal
lineage.db-wal
lineage.db-shm
*.bak

# The local email test sink. t_email.py needs the app started with
# EMAIL_SINK_PATH pointing inside /app so the suite on the host can read what
# the container wrote; this is where the checklist tells you to put it.
.mail-test.jsonl

# Generated exports
*.xlsx

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS / Office temp files
.DS_Store
~$*

# Node (only ever created by tooling containers)
node_modules/
package-lock.json

# The commit message for the release in hand. Claude writes it here and you run
# `git commit -F COMMIT_MSG.txt`, because a long message pasted into Terminal as
# a heredoc or a chain of -m flags breaks on the first quote, backtick or line
# that looks like a shell word. Untracked: it describes a commit rather than
# belonging to one, and it is rewritten every release.
COMMIT_MSG.txt
