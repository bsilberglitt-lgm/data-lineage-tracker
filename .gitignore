# Secrets / local configuration
.env

# Legacy SQLite database (the app now uses PostgreSQL). Kept on disk as a
# historical backup and as the source for migrate_sqlite_to_postgres.py, but
# deliberately untracked — otherwise `git add -A` would re-add it.
lineage.db
lineage.db-journal
lineage.db-wal
lineage.db-shm
*.bak

# Generated exports
*.xlsx

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS / Office temp files
.DS_Store
~$*

# Node (only ever created by tooling containers)
node_modules/
package-lock.json

# The commit message for the release in hand. Claude writes it here and you run
# `git commit -F COMMIT_MSG.txt`, because a long message pasted into Terminal as
# a heredoc or a chain of -m flags breaks on the first quote, backtick or line
# that looks like a shell word. Untracked: it describes a commit rather than
# belonging to one, and it is rewritten every release.
COMMIT_MSG.txt
